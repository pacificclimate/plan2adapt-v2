// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
  "name": "Plan 2 Adapt",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      // Update 'VARIANT' to pick a Python version: 3, 3.10, 3.9, 3.8, 3.7, 3.6
      // Append -bullseye or -buster to pin to an OS version.
      // Use -bullseye variants on local on arm64/Apple Silicon.
      "VARIANT": "ubuntu-24.04"
    }
  },
  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    // Keep the inner daemon's networks off 172.17.0.0/16: this container sits
    // on the host's default bridge, and an inner docker0 there takes the
    // gateway's address, 172.17.0.1, which cuts the network out every ~30 s.
    "ghcr.io/devcontainers/features/docker-in-docker:2.12.0": {
      "dockerDefaultAddressPool": "base=10.213.0.0/16,size=24"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.8.10"
    },
    "ghcr.io/devcontainers-contrib/features/poetry:2": {
      "version": "1.7.1"
    }
  },
  // Bind mounts below error out if their host source is missing (unlike the old
  // -v syntax, --mount does not auto-create it), so make sure these paths exist
  // before the container is created. Harmless no-ops for non-Claude-Code users:
  // they just get an empty dir/file mounted in.
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.claude && touch ${localEnv:HOME}/.claude.json",
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],
  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "bash ./.devcontainer/post-install.sh",
  "postStartCommand": "bash ./.devcontainer/post-start.sh",
  // Configure tool-specific properties.
  // "customizations": {},
  // Comment out to connect as root instead. More info: https://aka.ms/vscode-remote/containers/non-root.
  "remoteUser": "vscode",
  "runArgs": [
    // give a nicer name to the container
    "--name",
    "plan2adapt_${localEnv:USER}"
  ],
  "mounts": [
    // localEnv:HOME, not "~" -- nothing expands a tilde on this path.
    // Claude Code's config directory -- skills, plugins, agents, session
    // history -- and its settings file, so they persist into the container
    // instead of starting fresh each time.
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["EditorConfig.EditorConfig", "ms-vscode.makefile-tools"]
    }
  }
}
